#include <stdio.h>

int main() {
    int d1, c1, d2, c2;
    scanf("%d %d %d %d", &d1, &c1, &d2, &c2);

    int total_dollars = d1 + d2;
    int total_cents = c1 + c2;

    total_dollars += total_cents / 100;
    total_cents = total_cents % 100;

    printf("%d\n%d\n", total_dollars, total_cents);

    return 0;
}
