#include <stdio.h>

int main() {
    float units;
    scanf("%f", &units);

    float bill = 0.0;

    if (units <= 200) {
        // 0.50 per unit
        bill = units * 0.50;
    } else if (units <= 400) {
        // 0.65 per unit + 100 extra
        bill = (units * 0.65) + 100;
    } else if (units <= 600) {
        // 0.80 per unit + 200 extra
        bill = (units * 0.80) + 200;
    } else {
        // 1.25 per unit + 425 extra
        bill = (units * 1.25) + 425;
    }

    printf("Rs.%.0f\n", bill);

    return 0;
}
